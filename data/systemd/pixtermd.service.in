[Unit]
Description=pixterm session supervisor
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service pixterm-helper.socket
Wants=pixterm-helper.socket
Conflicts=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=pixterm
# A logind session on seat0/tty1 lets Xorg run without root privileges.
PAMName=pixterm
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=pixterm
RuntimeDirectoryMode=0700
# Configuration lives on the persistent partition at /var/lib/pixterm,
# owned by root and written only by pixterm-helper.
ExecStart=@PIXTERM_LIBEXEC_DIR@/pixtermd
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
