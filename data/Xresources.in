!
! X resources for pixterm's local mode (loaded through $XENVIRONMENT by
! pixterm-ui, pixterm-askpass, mwm and the xterm of terminal sessions).
! Classic Motif: gray surfaces, bevels, core bitmap fonts.

*background:              #bdbdbd
*foreground:              #000000
*XmList.background:       #d9d9d9
*XmTextField.background:  #d9d9d9
*highlightThickness:      2
*fontList:                -adobe-helvetica-medium-r-normal--14-*-*-*-p-*-iso8859-1
*XmPushButton.fontList:   -adobe-helvetica-bold-r-normal--14-*-*-*-p-*-iso8859-1

! ---- host chooser
! Root window: a classic X11 bitmap (root_weave, wide_weave, cross_weave)
! tiled in rootForeground/rootBackground, or "none" for a solid fill.
Pixterm.rootPattern:      wide_weave
Pixterm.rootForeground:   black
Pixterm.rootBackground:   white
Pixterm*title.fontList:   -adobe-helvetica-bold-r-normal--17-*-*-*-p-*-iso8859-1
Pixterm*hosts.fontList:   -adobe-helvetica-medium-r-normal--17-*-*-*-p-*-iso8859-1
Pixterm*hosts.visibleItemCount: 8
Pixterm*hostList.fontList: -adobe-courier-medium-r-normal--14-*-*-*-m-*-iso8859-1
Pixterm*foundList.fontList: -adobe-courier-medium-r-normal--14-*-*-*-m-*-iso8859-1
Pixterm*wifiList.fontList: -adobe-courier-medium-r-normal--14-*-*-*-m-*-iso8859-1
Pixterm*keyText.fontList: -adobe-courier-medium-r-normal--12-*-*-*-m-*-iso8859-1
Pixterm*diagText.fontList: -adobe-courier-medium-r-normal--12-*-*-*-m-*-iso8859-1
Pixterm*categories.fontList: -adobe-helvetica-bold-r-normal--14-*-*-*-p-*-iso8859-1
Pixterm*login.marginWidth:     12
Pixterm*login.marginHeight:    4
Pixterm*find.marginWidth:      12
Pixterm*find.marginHeight:     4
Pixterm*configure.marginWidth: 12
Pixterm*configure.marginHeight: 4
Pixterm*version.fontList: -adobe-helvetica-medium-r-normal--12-*-*-*-p-*-iso8859-1
Pixterm*network.fontList: -adobe-helvetica-medium-r-normal--12-*-*-*-p-*-iso8859-1
Pixterm*errorDialog_popup.title:     pixterm
Pixterm*connectingDialog_popup.title: pixterm
Pixterm*userDialog_popup.title:      pixterm
Pixterm*configureDialog_popup.title: pixterm
Pixterm*pinDialog_popup.title:       pixterm

! ---- askpass
PixtermAskpass*secret.fontList: -adobe-courier-medium-r-normal--14-*-*-*-m-*-iso8859-1

! ---- window manager
Mwm*configFile:           @PIXTERM_DATA_DIR@/mwmrc
Mwm*keyboardFocusPolicy:  explicit
Mwm*startupKeyFocus:      True
Mwm*focusAutoRaise:       True
Mwm*useIconBox:           False
Mwm*iconAutoPlace:        False
Mwm*enableWarp:           False
Mwm*interactivePlacement: False
Mwm*clientAutoPlace:      False
Mwm*positionIsFrame:      False
Mwm*showFeedback:         none
Mwm*windowMenu:           PixtermWindowMenu
Mwm*buttonBindings:       PixtermButtons
Mwm*keyBindings:          PixtermKeys
Mwm*fontList:             -adobe-helvetica-bold-r-normal--14-*-*-*-p-*-iso8859-1
Mwm*background:           #bdbdbd
! Window frames: black with white titles ("client" = decorations only, so
! mwm's menus keep the gray Motif look).
Mwm*client*background:            #000000
Mwm*client*foreground:            #a0a0a0
Mwm*client*topShadowColor:        #4a4a4a
Mwm*client*bottomShadowColor:     #000000
Mwm*client*activeBackground:      #000000
Mwm*client*activeForeground:      #ffffff
Mwm*client*activeTopShadowColor:  #6a6a6a
Mwm*client*activeBottomShadowColor: #000000

! ---- IBM mainframe sessions (x3270)
! No menu bar or scroll bar (and no keypad, x3270's default): the screen
! is the 3270's. The key map adds PC keys
! to x3270's own: Right Ctrl and keypad Enter are Enter, Escape is Reset,
! Shift+Escape is Attn, Pause is Clear, Page Up and Down are PF7 and PF8.
x3270.menuBar:            false
x3270.scrollBar:          false
x3270.keymap.pixterm:     #override \n\
	Shift<Key>Escape: Attn()\n\
	:<Key>Escape: Reset()\n\
	:<Key>Control_R: Enter()\n\
	:<Key>KP_Enter: Enter()\n\
	:<Key>Pause: Clear()\n\
	:<Key>Prior: PF(7)\n\
	:<Key>Next: PF(8)

! ---- IBM i sessions (tn5250 in a terminal named tn5250)
! The 5250 keys, as the escape sequences tn5250 reads: F1 to F12, and
! Shift+F1 to F12 for F13 to F24; Escape is Reset, Shift+Escape
! Attention, Ctrl+Escape System Request, Pause Clear; Return, keypad
! Enter and Right Ctrl are Enter, Shift+Return Field Exit; keypad + and
! - are Field+ and Field-; Scroll Lock is Help, Print is Print.
tn5250*VT100.Translations: #override \n\
	Shift<Key>F1: string("\033!")\n\
	Shift<Key>F2: string("\033@")\n\
	Shift<Key>F3: string("\033#")\n\
	Shift<Key>F4: string("\033$")\n\
	Shift<Key>F5: string("\033%")\n\
	Shift<Key>F6: string("\033^")\n\
	Shift<Key>F7: string("\033&")\n\
	Shift<Key>F8: string("\033*")\n\
	Shift<Key>F9: string("\033(")\n\
	Shift<Key>F10: string("\033)")\n\
	Shift<Key>F11: string("\033_")\n\
	Shift<Key>F12: string("\033+")\n\
	:<Key>F1: string("\0331")\n\
	:<Key>F2: string("\0332")\n\
	:<Key>F3: string("\0333")\n\
	:<Key>F4: string("\0334")\n\
	:<Key>F5: string("\0335")\n\
	:<Key>F6: string("\0336")\n\
	:<Key>F7: string("\0337")\n\
	:<Key>F8: string("\0338")\n\
	:<Key>F9: string("\0339")\n\
	:<Key>F10: string("\0330")\n\
	:<Key>F11: string("\033-")\n\
	:<Key>F12: string("\033=")\n\
	Shift<Key>Escape: string("\033A")\n\
	Ctrl<Key>Escape: string("\033S")\n\
	:<Key>Escape: string("\033R")\n\
	:<Key>Pause: string("\033C")\n\
	Shift<Key>Return: string("\033X")\n\
	:<Key>Control_R: string("\015")\n\
	:<Key>KP_Enter: string("\015")\n\
	:<Key>KP_Add: string("\030")\n\
	:<Key>KP_Subtract: string("\033M")\n\
	:<Key>Scroll_Lock: string("\033H")\n\
	:<Key>Print: string("\033P")

! ---- terminal sessions
! The xterm of SSH terminal and Telnet hosts: black on white, and the
! host may not move, resize or retitle it or change its font.
XTerm*VT100.background:     white
XTerm*VT100.foreground:     black
XTerm*VT100.cursorColor:    black
XTerm*VT100.saveLines:      2000
XTerm*VT100.allowWindowOps: false
XTerm*VT100.allowFontOps:   false
XTerm*VT100.allowTitleOps:  false
